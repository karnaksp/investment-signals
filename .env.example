TINVEST_TOKEN=replace-with-your-token
TINVEST_USE_SANDBOX=false
TINVEST_APP_NAME=tinvest-signal-engine

HOST_KAFKA_PORT=39092
HOST_REDPANDA_METRICS_PORT=39644
HOST_REDPANDA_CONSOLE_PORT=38080
HOST_SCHEMA_REGISTRY_PORT=18081
HOST_POSTGRES_PORT=35432
HOST_CLICKHOUSE_HTTP_PORT=38123
HOST_CLICKHOUSE_NATIVE_PORT=39000
HOST_PROMETHEUS_PORT=39090
HOST_GRAFANA_PORT=33000
HOST_API_PORT=38000
HOST_ACCURACY_METRICS_PORT=39110
HOST_DAGSTER_PORT=30300

KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_HOST_BOOTSTRAP_SERVERS=localhost:39092
KAFKA_RAW_TOPIC=marketdata.raw
KAFKA_SIGNAL_TOPIC=marketdata.signals
KAFKA_CONSUMER_GROUP=signal-detector
KAFKA_AUTO_OFFSET_RESET=latest
# Низкая задержка продюсера: малый linger + lz4 (или none/snappy/zstd).
KAFKA_LINGER_MS=5
KAFKA_BATCH_BYTES=32768
KAFKA_COMPRESSION_CODEC=lz4
# Формат значения в топиках: json | protobuf (protobuf требует SR или KAFKA_PROTOBUF_SCHEMA_ID_*).
KAFKA_RAW_VALUE_FORMAT=json
KAFKA_SIGNAL_VALUE_FORMAT=json
SCHEMA_REGISTRY_URL=http://redpanda:8081
# После scripts/register_schemas_sr.py можно зафиксировать id и не дергать SR на каждом старте:
# KAFKA_PROTOBUF_SCHEMA_ID_RAW=
# KAFKA_PROTOBUF_SCHEMA_ID_SIGNAL=
# Каталог .proto для контейнера задан в compose (PROTO_DIR=/app/proto). На хосте при необходимости:
# PROTO_DIR=proto
LOCAL_NOTIFIER_CONSUMER_GROUP=local-notifier
LOCAL_NOTIFICATION_DURATION_SECONDS=5

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=signal_engine
POSTGRES_USERNAME=signal_engine
POSTGRES_PASSWORD=signal_engine
POSTGRES_TABLE=market_signals
POSTGRES_STARTUP_TIMEOUT_SECONDS=90
POSTGRES_STARTUP_CHECK_INTERVAL_SECONDS=2

API_HOST=0.0.0.0
API_PORT=8000
# Uvicorn --reload для правок Python без перезапуска (в docker-compose для api включено по умолчанию).
# TINVEST_API_RELOAD=false
# Токен для JSON /admin/api/* и ввода на странице /admin (не публикуйте в git).
ADMIN_API_TOKEN=

ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
LOG_LEVEL=INFO

# Опционально: не писать в Postgres/Kafka и не слать webhook/Telegram, если quality_score
# (после enrich) ниже порога. Пусто или 0 в переменной — фильтр выключен.
# SIGNAL_MIN_QUALITY_SCORE=55

# Prometheus metrics HTTP для детектора (в compose по умолчанию 9108). Пусто — выключено.
METRICS_LISTEN_PORT=9108

# Redis (рекомендуется в compose): состояние детектора между рестартами (cooldown + окна).
# В docker-compose сервис detector ждёт redis; без URL Redis не используется.
REDIS_URL=redis://redis:6379/0
# Периодический сброс состояния cooldown в Redis (сек). 0 — только при остановке и reload YAML.
REDIS_ALERT_FLUSH_INTERVAL_SECONDS=30
HOST_REDIS_PORT=36379

# Офлайн-метрики точности (сервис accuracy-metrics): JSON из duckdb_label_signals → Prometheus.
# Локально для API-админки: var/accuracy/signal_accuracy.json (в compose для api задаётся /app/var/accuracy/...).
SIGNAL_ACCURACY_JSON_PATH=/data/signal_accuracy.json
ACCURACY_METRICS_PORT=9110
SIGNAL_ACCURACY_REFRESH_SECONDS=30

# Интеграционные тесты (pytest): docker compose up, затем RUN_INTEGRATION=1
RUN_INTEGRATION=
CLICKHOUSE_HTTP_URL=http://localhost:38123
# Для админки `/admin/api/signal/.../context`: те же учётные данные, что для ClickHouse HTTP.
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=clickhouse_dev_password
# Для админки: в compose для api задаётся `CLICKHOUSE_HTTP_URL=http://clickhouse:8123`.

# Интервал опроса mtime conf/*.yaml для горячей подхватки (сек). 0 — только при рестарте контейнера.
CONFIG_RELOAD_INTERVAL_SECONDS=10

DETECTORS_OVERRIDES_CONFIG=conf/detectors.overrides.yaml
THRESHOLD_RECALC_INTERVAL_HOURS=24
THRESHOLD_LOOKBACK_DAYS=7
# Итоговый порог = среднее почасовое отклонение (bps) * multiplier
THRESHOLD_HOURLY_DEVIATION_MULTIPLIER=1.0

# Dagster (docker compose): cron пересчёта порогов и unary single-shot, UTC.
# DAGSTER_THRESHOLD_CRON=0 2 * * *
# DAGSTER_UNARY_CRON=*/15 * * * *

# Один цикл unary и выход (Dagster / ручной запуск). Сервис `market-unary-emitter` в цикле не выставляет.
# MARKET_UNARY_SINGLE_SHOT=1

# Опционально: сервис `market-unary-emitter` (docker compose --profile unary).
# Период публикации unary-снимков в KAFKA_RAW_TOPIC; детектор эти event_type не обрабатывает (только OLAP/отладка).
# MARKET_UNARY_POLL_SECONDS=300
# MARKET_UNARY_MODES=market_values
# MARKET_UNARY_MODES=market_values,tech_analysis
# MARKET_UNARY_MARKET_VALUE_TYPES=last_price,open_interest,close_price
# MARKET_UNARY_TECH_INDICATOR=rsi
# MARKET_UNARY_TECH_INTERVAL=1h
# MARKET_UNARY_TECH_TYPE_OF_PRICE=close
# MARKET_UNARY_TECH_LENGTH=14
# MARKET_UNARY_TECH_WINDOW_MINUTES=1440
# MARKET_UNARY_TECH_SLEEP_MS=250
# MARKET_UNARY_MAX_BACKOFF_SECONDS=900
# MARKET_UNARY_METRICS_LISTEN_PORT=9109
# Отдельный Kafka-топик для unary (иначе пишется в KAFKA_RAW_TOPIC — детектор видит для unary_context).
# KAFKA_RAW_UNARY_TOPIC=marketdata.raw.unary

# Админ API: лимит запросов /admin/api на IP в минуту (0 = выключено).
# ADMIN_API_RATE_LIMIT_PER_MINUTE=120
# Список разрешённых IP для /admin/api (пусто = все). За reverse proxy смотрите X-Forwarded-For.
# ADMIN_API_ALLOWED_IPS=127.0.0.1,::1
